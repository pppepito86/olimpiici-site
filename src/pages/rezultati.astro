---
import Base from '../layouts/Base.astro';
---
<Base
  title="Резултати | Олимпийци"
  description="500+ класирани на НОМ и НОИ, 37 международни медала."
  canonical="https://olimpiici.com/rezultati"
>
  <main class="page-main">
<div class="breadcrumb"><a href="/">Начало</a><span class="sep">›</span>Успехи</div>
  <section class="section">
    <div class="eyebrow rv">Успехи</div>
    <div class="sec-title rv">Числата говорят сами</div>
    <p class="sec-sub rv">Реални резултати от реални ученици. Всяка година добавяме нови.</p>
    <div class="results-grid">
      <div class="result-card rv"><div class="result-ico">🏆</div><div class="result-num">500+</div><div class="result-lbl">Класирани на НОМ и НОИ (2019–2026)</div></div>
      <div class="result-card rv"><div class="result-ico">🎯</div><div class="result-num">70+</div><div class="result-lbl">В топ 3 на НОМ и НОИ (2019–2026)</div></div>
      <div class="result-card rv"><div class="result-ico">🥇</div><div class="result-num">10</div><div class="result-lbl">Златни медала BOI · IOI · EJOI</div></div>
      <div class="result-card rv"><div class="result-ico">🥈</div><div class="result-num">10</div><div class="result-lbl">Сребърни медала</div></div>
      <div class="result-card rv"><div class="result-ico">🥉</div><div class="result-num">17</div><div class="result-lbl">Бронзови медала</div></div>
      <div class="result-card rv"><div class="result-ico">🌍</div><div class="result-num">37</div><div class="result-lbl">Общо международни медала</div></div>
    </div>
  </section>
  <section class="section section-alt rv">
    <div class="eyebrow">Хронология</div>
    <div class="sec-title">Избрани постижения</div>
    <p class="sec-sub">Някои от най-гордите моменти на нашите ученици.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px">
      <div>
        <h3 style="font-family:'Baloo 2',cursive;font-size:20px;font-weight:800;color:var(--dark);margin-bottom:20px">📐 Състезателна математика</h3>
        <div class="timeline">
          <div class="tl-item rv"><div class="tl-year">НОМ 2025</div><div class="tl-title">31 класирани</div><div class="tl-desc">4 от 7. клас · 6 от 8. клас · 21 от 9–12 клас · 2 в топ 3</div></div>
          <div class="tl-item rv"><div class="tl-year">НОМ 2024</div><div class="tl-title">36 класирани</div><div class="tl-desc">7 от 7. клас · 11 от 8. клас · 18 от 9–12 клас · 7 в топ 3</div></div>
          <div class="tl-item rv"><div class="tl-year">НОМ 2023</div><div class="tl-title">25 класирани</div><div class="tl-desc">7 от 7. клас · 4 от 8. клас · 14 от 9–12 клас · 3 в топ 3</div></div>
          <div class="tl-item rv"><div class="tl-year">НОМ 2022</div><div class="tl-title">28 класирани</div><div class="tl-desc">2 от 7. клас (2 допуснати от 7) · 8 от 8. клас · 18 от 9–12 клас · 6 в топ 3</div></div>
          <div class="tl-item rv"><div class="tl-year">НОМ 2021</div><div class="tl-title">26 класирани</div><div class="tl-desc">7 от 8. клас · 19 от 9–12 клас · 1 в топ 3 (без данни за 7 клас)</div></div>
